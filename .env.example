# ── API Keys ──────────────────────────────────────────
# Gemini API (obrigatório) — obtenha em https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# BacDive API — registre-se em https://bacdive.dsmz.de/api/bacdive/
BACDIVE_EMAIL=your-email@example.com
BACDIVE_PASSWORD=your-bacdive-password

# ── Configuração do servidor ─────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Configuração da IA ───────────────────────────────
GEMINI_MODEL=gemini-2.0-flash
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=4096
